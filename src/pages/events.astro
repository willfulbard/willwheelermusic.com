---
import BaseLayout from '~/layouts/BaseLayout.astro';
import EventList from '~/components/EventList.astro';
import { getUpcomingEvents, CALENDAR_PUBLIC_URL } from '~/lib/calendar';

const events = await getUpcomingEvents();
---

<BaseLayout title="Events">
  <section class="container section events-page">
    <h1>Upcoming Events</h1>
    <p class="lede">
      Where to catch Will and his projects on the dance floor and beyond.
    </p>
    <p class="calendar-link">
      <a href={CALENDAR_PUBLIC_URL} target="_blank" rel="noopener noreferrer">
        Add this calendar to your own Google Calendar →
      </a>
    </p>
    <EventList events={events} />
  </section>
</BaseLayout>

<style>
  .events-page {
    padding-left: var(--space-3);
    padding-right: var(--space-3);
  }

  .lede {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .calendar-link {
    font-size: 0.95rem;
    margin-bottom: var(--space-5);
  }
</style>
